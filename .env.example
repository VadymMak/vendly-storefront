# База данных (Neon PostgreSQL)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth (NextAuth v5 — используй AUTH_SECRET, не NEXTAUTH_SECRET!)
AUTH_SECRET=

# Cloudflare Turnstile on /register (read at runtime — no rebuild needed). Widget type: Managed.
# Unset → challenge not enforced. AUTH_SECRET is also the HMAC key for hashed sign-up IPs.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

AUTH_URL=http://localhost:3000

# Stripe Connect
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# OpenAI
OPENAI_API_KEY=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Server-local file storage (src/lib/storage.ts); STORAGE_BACKEND=blob rolls back to Vercel Blob
UPLOAD_DIR=/home/vadym/uploads
UPLOAD_BASE_URL=https://vendshop.shop/uploads

# Resend
RESEND_API_KEY=
FROM_EMAIL=noreply@vendshop.shop

# Vercel Domains API
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Admin
ADMIN_EMAIL=

# Platform
NEXT_PUBLIC_ROOT_DOMAIN=vendshop.shop
NEXT_PUBLIC_BASE_URL=https://vendshop.shop

# Video provider: 'kling' (default, Replicate) or 'wan' (self-hosted Wan 2.2)
VIDEO_PROVIDER=kling
# Wan 2.2 endpoint — only needed when VIDEO_PROVIDER=wan
# WAN_API_URL=http://localhost:8188
